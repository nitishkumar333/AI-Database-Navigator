# ──────────────────────────────────────────────
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sqlnav

# ── Backend (FastAPI) ───────────────────────
SECRET_KEY=your-super-secret-key-change-this
GEMINI_API_KEY=your-gemini-api-key
ENCRYPTION_KEY=your-fernet-encryption-key

# ── Frontend ────────────────────────────────
# URL where the backend API is reachable from the browser
# In production, set this to your domain e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LLM provider ────────────────────────────
LLM_PROVIDER=gemini            # gemini | groq | deepseek
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash  # or deepseek-v4-pro
DEEPSEEK_THINKING=false        # true: thinking mode (slower, more tokens)

# ── SQL agent mode ──────────────────────────
# production: full loop (explore -> submit_answer -> natural-language answer)
# evaluation: stop once an answer is submitted (no answer-generation tokens)
AGENT_MODE=production
# Terminal log of every LLM call and tool call with parameters ([agent] lines):
# INFO = calls + results, DEBUG = also full tool output, WARNING = off
AGENT_LOG_LEVEL=INFO
# The agent's prompt holds the full schema when it fits this many characters
# (~8k tokens); above it, only the table list, and the agent reads columns
# with its describe_tables tool
AGENT_FULL_SCHEMA_MAX_CHARS=32000
# Earlier turns of a conversation the agent sees: the last N may be sent in
# full, older ones shortened (question, final SQL, first rows, reply), all
# within this many characters (~6k tokens). The current turn is always whole.
AGENT_HISTORY_FULL_TURNS=2
AGENT_HISTORY_MAX_CHARS=24000

# ── LangSmith tracing (backend/app/observability.py) ─────
# Every chat turn becomes one trace: graph nodes, LLM calls (tokens, cost) and
# tool calls, labelled with user_id / conn_id / conversation_id / turn_id.
# Query result rows are always hidden from traces. Evaluation runs are never traced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sqlnav-dev

# ── Rate limits (backend/app/services/rate_limiter.py) ─────
# "count/seconds", comma-separated for several windows ("5/60,60/3600" = 5 a
# minute and 60 an hour). An empty value turns that limit off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_IP=240/60                 # every /api request, per IP
RATE_LIMIT_AUTH_IP=10/60,50/3600         # login, register, per IP
RATE_LIMIT_GUEST_LOGIN_IP=5/600,20/86400 # guest logins, per IP (guests count per IP in all limits)
RATE_LIMIT_CHAT_USER=5/60,60/3600        # chat questions, per user
RATE_LIMIT_CHAT_IP=10/60,150/3600        # chat questions, per IP
RATE_LIMIT_SUGGESTIONS_USER=10/60,120/3600
RATE_LIMIT_HEAVY_USER=10/600             # add/test a connection, re-profile a schema

# ── Schema profiling (AI context) ───────────
# Profiling reads catalogs + planner statistics (no LLM). Describing writes
# table/column descriptions with one LLM call per table, once per table
# structure, until every table is described (knowledge-base tables first);
# set it to false to save LLM quota.
SCHEMA_PROFILING_ENABLED=true
# Terminal log of these background jobs ([jobs] lines): INFO = every step,
# WARNING = problems only, ERROR = off
JOB_LOG_LEVEL=INFO
SCHEMA_DESCRIBE_ENABLED=true
SCHEMA_DESCRIBE_MAX_TABLES=50   # batch size: retrieval is re-indexed after this many descriptions
SCHEMA_CHECK_INTERVAL_S=300     # how often to look for schema changes

# Schema retrieval index (pgvector + pg_trgm in the app database, built after
# profiling). Without JINA_API_KEY it uses trigram and value matching only;
# without pgvector the agent falls back to keyword search.
SCHEMA_RETRIEVAL_ENABLED=true
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIM=1024              # changing it re-embeds every index
# When the schema is too big for the prompt (AGENT_FULL_SCHEMA_MAX_CHARS), the
# tables retrieved for each question are added in full, up to:
SCHEMA_LINK_MAX_TABLES=8          # 0 = no schema linking (table list only)
SCHEMA_LINK_MAX_CHARS=24000
