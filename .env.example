# ──────────────────────────────────────────────
# Elysia (SQLNav) — Docker Environment Variables
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sqlnav

# ── Backend (FastAPI) ───────────────────────
SECRET_KEY=your-super-secret-key-change-this
GEMINI_API_KEY=your-gemini-api-key
ENCRYPTION_KEY=your-fernet-encryption-key

# ── Frontend ────────────────────────────────
# URL where the backend API is reachable from the browser
# In production, set this to your domain e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LLM provider ────────────────────────────
LLM_PROVIDER=gemini            # gemini | groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# ── SQL agent mode ──────────────────────────
# production: full loop (SQL tool -> natural-language answer)
# evaluation: stop after the SQL tool succeeds (no answer-generation tokens)
AGENT_MODE=production

# ── Schema profiling (AI context) ───────────
# Profiling reads catalogs + planner statistics (no LLM). Describing writes
# table/column descriptions with one LLM call per table, once per table
# structure; set it to false to save LLM quota.
SCHEMA_PROFILING_ENABLED=true
SCHEMA_DESCRIBE_ENABLED=true
SCHEMA_DESCRIBE_MAX_TABLES=50   # per refresh; the rest are described on later refreshes
SCHEMA_CHECK_INTERVAL_S=300     # how often to look for schema changes
