# Copy to evaluation/.env. Anything not set here falls back to backend/.env,
# and real environment variables always win.

# Postgres database holding the BIRD mini-dev tables.
BIRD_DB_URL=postgresql://postgres:password@localhost:5432/bird

# Default provider for `python -m evaluation run` (override with --provider)
LLM_PROVIDER=gemini            # gemini | groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
